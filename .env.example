# Copy to .env and fill in. The .env file holds the broker password: keep it on the server.

# MQTT broker the ChirpStack Gateway Bridge publishes to (your EMQX)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
# Ideally a dedicated user that may only subscribe to eu868/gateway/#
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TLS=true

# Region topic prefix of the gateway bridge. Subscribes to <prefix>/gateway/+/event/up,
# <prefix>/gateway/+/event/stats and <prefix>/gateway/+/state/conn
TOPIC_PREFIX=eu868
# ...or list the topics yourself, comma separated (e.g. if the broker ACL refuses one):
# MQTT_TOPICS=eu868/gateway/+/event/up,eu868/gateway/+/event/stats

# Your own devices (DevAddr, hex, comma separated). Each address here is taken over once into
# data/devices.json; after that add, rename and remove devices in the web UI (a device removed
# there stays removed). Their rows get is_own=1, and the UI shows how each gateway hears them.
OWN_DEVADDRS=
# e.g. OWN_DEVADDRS=00a1b2c3,260b1234

# Initial names for the web UI (gateway id=name, comma separated). Gateways can be renamed
# in the UI; a name set there wins over this list. New gateways are picked up by themselves.
GATEWAY_NAMES=
# e.g. GATEWAY_NAMES=0016c001f1000001=Roof,b827ebfffe000003=Lab

# Delete daily files older than this many days (0 = keep everything)
KEEP_DAYS=0

# No message for this many minutes: the capture counts as not recording, /healthz fails and
# Unraid shows the container as unhealthy. A gateway silent this long is a warning.
# HEALTH_SILENCE_MINUTES=10

# Optional login for the web UI (HTTP basic auth)
# WEB_USERNAME=
# WEB_PASSWORD=

# LOG_LEVEL=INFO
